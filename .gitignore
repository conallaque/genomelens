# ── Personal genetic data — NEVER commit ────────────────────────────────────
# Raw DNA files (any consumer chip format)
*.csv
*.txt

# The blanket *.csv rule above exists to keep genotype files out of the repo
# and must stay. Public reference data that the model needs at run time is
# allowed back in ONE FILE AT A TIME, by exact path, never by pattern — a
# directory-wide or extension-wide exception here is how a genome file
# eventually slips through. Provenance for each is in data/PROVENANCE.md.
!data/LifeTable_USA_Mx_2015.csv
*.vcf
*.vcf.gz
*.bcf
*.fam
*.bim
*.bed
*.ped
*.map
*.gen
*.gen.gz
*.bgen
*.zip
*.tar
*.tar.gz
*.tgz

# Specific raw-file naming patterns
genome*.txt
genome*.csv
*23andMe*
*AncestryDNA*
*ftdna*
*MyHeritage*
*TellmeGen*
WUTED*

# ── Generated reports & analysis output ────────────────────────────────────
report.html
report.pdf
narrative_report.html
narrative_report.pdf
carrier_report.html
carrier_report.pdf
emergency_card.html
emergency_card.pdf
supplements.html
exercise.html
nutrition.html
bloodwork.html
longevity.html
economic_analysis.html
# Consolidated economics page. Added 2026-08-24 after this file was committed by
# accident: the pipeline writes it beside the report, a run had been pointed at
# the repo directory, and the filename was new so no existing rule covered it.
# The blanket DNA rules match *.csv/*.txt/*.vcf; generated HTML needs naming.
economics.html
personalized_plan.html
genome_comparison.html
fhir_bundle.json
tier1_results.json
failed_categories.json
changelog.json
labs*.json
bloodwork*.json

# ── Cache / intermediate data ──────────────────────────────────────────────
imputation_cache/
beagle_cache/
*.imputed.vcf
*.imputed.vcf.gz
reference/1000g/
reference/pgs_scores/
reference/beagle/
reference/clinvar/
reference/*.vcf*
reference/*.bgen*
reference/*.bed
reference/*.bim
reference/*.fam
reference/*.tar*
reference/*.zip

# Predictor reference tables (AlphaMissense / REVEL / CADD / gnomAD / SpliceAI) can be huge
# (CADD ~81 GB). Belt-and-suspenders: ignore everything under reference/ except tracked metadata.
reference/*

# Allow setup metadata in reference/
!reference/setup_manifest.json
!reference/README*
!reference/PREDICTOR_LICENSES.md

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
dist/
build/
.tox/
.nox/

# ── Editor / OS ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/

# ── Allow the small included test genome and SNP DB only ───────────────────
!test_genome.txt
!snp_database.json

# Same one-file-at-a-time rule as the LifeTable exception above. The blanket
# *.txt rule is what keeps raw genome files out; these two are dependency
# manifests that happen to share the extension. Without them nobody who clones
# the repo can install anything, and CI cannot run at all — both were silently
# untracked until the CI workflow tried to read them.
!requirements.txt
!requirements-dev.txt
.preview/
